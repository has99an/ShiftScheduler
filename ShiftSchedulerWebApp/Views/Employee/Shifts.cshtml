@model IEnumerable<ShiftSchedulerWebApp.Models.Shift>

<h2>Shifts for @Model.FirstOrDefault()?.EmployeeFullName</h2>

<p>
    <a asp-action="Create" asp-route-employeeId="@(Model.Any() ? Model.First().EmployeeID : 0)">Create New Shift</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Shift ID</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Date</th>
            <th>Employee</th> 
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var shift in Model)
        {
            <tr>
                <td>@shift.ShiftID</td>
                <td>@shift.EmployeeID</td>
                <td>@shift.StartTime</td>
                <td>@shift.EndTime</td>
                <td>@shift.Date.ToShortDateString()</td>
                <td>
                    <a asp-controller="Shift" asp-action="Edit" asp-route-id="@shift.ShiftID">Edit</a>
                    <a href="#" onclick="confirmDelete(@shift.ShiftID)">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    function confirmDelete(shiftId) {
        if (confirm("Er du sikker på, at du vil slette dette skift?")) {
            fetch(`/Shift/Delete/${shiftId}`, {
                method: 'DELETE'
            })
                .then(response => {
                    if (response.ok) {
                        alert("Skiftet er slettet.");
                        location.reload();
                    } else {
                        alert("Fejl ved sletning af skiftet.");
                    }
                })
                .catch(error => alert("Der opstod en fejl: " + error));
        }
    }
</script>
