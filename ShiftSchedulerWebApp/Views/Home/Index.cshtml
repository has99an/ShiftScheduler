@{
    ViewData["Title"] = "Home Page";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.0/main.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.0/main.min.js"></script>

<div id="calendar"></div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');
        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'timeGridWeek',
            events: '/Shift/GetShiftsForCalendar',
            slotMinTime: "10:00:00",
            slotMaxTime: "23:00:00",
            eventDidMount: function (info) {
                if (info.event.extendedProps.type === 'Fixed') {
                    info.el.style.backgroundColor = 'green';
                } else {
                    info.el.style.backgroundColor = 'red';
                }
            }
        });
        calendar.render();
    });
</script>

<style>
    #calendar {
        max-width: 90%;
        height: 80vh; /* 80% af skærmhøjden */
        margin: 0 auto;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .fc-toolbar {
        background-color: #4CAF50;
        color: white;
        padding: 10px;
        border-radius: 8px;
    }

    .fc-button {
        background-color: #4CAF50;
        color: white;
        border: none;
        border-radius: 4px;
        font-weight: bold;
    }

        .fc-button:hover {
            background-color: #45a049;
        }

    .fc-daygrid-day-number {
        font-size: 16px;
        color: #333;
    }

    .fc-daygrid-event {
        border-radius: 4px;
        padding: 5px;
        text-align: center;
        font-size: 14px;
        font-weight: bold;
    }

        .fc-daygrid-event.fc-event {
            background-color: #8BC34A; /* Grøn for Fixed */
            color: white;
        }

            .fc-daygrid-event.fc-event.open {
                background-color: #FF5252; /* Rød for Open */
                color: white;
            }

    .fc-daygrid-day.fc-day-today {
        background-color: #F1F8E9;
    }

    .fc-header-toolbar {
        border-bottom: 2px solid #4CAF50;
    }
</style>
